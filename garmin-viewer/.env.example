# Copy this file to .env and fill in your own values. Never commit .env.

# Your own Garmin Connect credentials. Used only to log this server in to
# https://connect.garmin.com on your behalf; stored nowhere but your Garmin
# session tokens on this machine (see server/.data/tokens.json).
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Port the server listens on.
PORT=8123

# Optional. If set, morning/evening briefings are phrased by Claude instead
# of the built-in templates. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. How often (cron syntax, UTC) to refresh Garmin data in the
# background so the dashboard opens instantly. Default: every 2 hours.
SYNC_CRON=0 */2 * * *

# Optional. Point these at a deployed garmin-backend/ Python service (see
# that project's README) to get real live Garmin data through it instead of
# GARMIN_USERNAME/PASSWORD above. Garmin's login is Cloudflare-blocked from
# Render's datacenter IPs, which is why that separate service exists -- it
# authenticates once via a local login done from a residential IP instead.
# Leaving these unset keeps the direct-login path above.
PYTHON_BACKEND_URL=
PYTHON_BACKEND_TOKEN=
