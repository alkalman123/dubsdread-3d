# Where the Garmin OAuth tokenstore lives. This is a *directory* --
# python-garminconnect writes/reads garmin_tokens.json inside it.
# On Render's free tier this disk is ephemeral (wiped on every deploy and
# on most restarts), so also set GARMIN_TOKENSTORE_JSON below as a backup:
# on boot, if this path is empty but that env var is set, we recreate the
# file from it before starting the scheduler.
GARMIN_TOKENSTORE_PATH=./.data/garmin_tokens

# Backup copy of the tokenstore, as a single JSON string. Produced by
# `python cli_login.py` (it prints this after a successful login/resume).
# Paste it in here as a Render environment variable so a redeploy or a
# filesystem wipe doesn't force you to re-run the interactive login.
GARMIN_TOKENSTORE_JSON=

# SQLite file. Same ephemeral-disk caveat as above applies -- this is
# fine for now (data gets rebuilt from Garmin on the next sync after a
# wipe, at the cost of an extra backfill), but if that ever becomes a
# problem, point this at a Render persistent disk instead.
DATABASE_PATH=./.data/garmin.db

# Bearer token the mobile app / Alpine Log frontend must send as
# `Authorization: Bearer <this value>` to call this backend's API.
# This is NOT your Garmin password -- it's a secret you make up yourself,
# e.g. `openssl rand -hex 32`.
BACKEND_API_TOKEN=change-me

# How often (minutes) the background sync job re-pulls the last few days
# of wellness + activity data.
SYNC_INTERVAL_MINUTES=30

# How many days back a fresh backfill goes when no synced data exists yet.
BACKFILL_DAYS=365
